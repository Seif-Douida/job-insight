# Copy to .env at the repo root and fill in. Never commit .env.

# Neon Postgres — raw, staging and marts all live here
DATABASE_URL=postgresql://user:password@host.neon.tech/jobinsight?sslmode=require

# Google AI Studio — Gemma 4 is the default extraction model (30 RPM / 14,400 RPD free)
GEMINI_API_KEY=
EXTRACTION_MODEL=gemma-4-26b-a4b-it
EXTRACTION_BACKEND=gemini            # gemini | ollama
EXTRACTION_RPM=25                    # kept under the 30 RPM quota
EXTRACTION_DAILY_CAP=13000           # kept under the 14,400 RPD quota

# Local backend for development and benchmarking
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Adzuna — breadth and salary (free tier: 1,000 calls/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via OpenWeb Ninja (openwebninja.com) — Gulf coverage (free tier: 200 calls/month)
JSEARCH_API_KEY=

# Local test database: the compose Postgres on port 5433. Tests truncate its tables,
# so never point this at Neon. Create it once with:
#   docker compose -f infra/docker-compose.yml exec postgres createdb -U airflow jobinsight_test
TEST_DATABASE_URL=postgresql://airflow:airflow@localhost:5433/jobinsight_test

# Airflow container: set to your host UID on Linux; 50000 is fine on Windows/macOS
AIRFLOW_UID=50000
